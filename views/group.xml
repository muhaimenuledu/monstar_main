<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action with Multi-Company Session Context & Domain -->
    <record id="action_group_party" model="ir.actions.act_window">
        <field name="name">Partner Ledger Group</field>
        <field name="res_model">group.party</field>
        <field name="view_mode">list,form</field>
        <!-- Binds default company context dynamically to the active session company -->
        <field name="context">{'default_company_id': allowed_company_ids[0]}</field>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]</field>
    </record>

    <!-- List (Tree) View -->
    <record id="view_group_party_list" model="ir.ui.view">
        <field name="name">group.party.list</field>
        <field name="model">group.party</field>
        <field name="arch" type="xml">
            <list string="Partner Ledger Group">
                <field name="company_id" optional="show"/>
                <field name="partner_journal_breakdown"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_group_party_form" model="ir.ui.view">
        <field name="name">group.party.form</field>
        <field name="model">group.party</field>
        <field name="arch" type="xml">
            <form string="Partner Ledger Group">
                <header>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Export Partner Detail XLSX"
                            class="btn-primary"/>
                    <button name="action_export_totals_xlsx"
                            type="object"
                            string="Export Partner Totals Only XLSX"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="partner_id"/>
                        <field name="vendor_group"/>
                    </group>
                    <group>
                        <button name="action_refresh_current_company"
                                type="object"
                                string="🔄 Refresh Company"
                                class="btn-primary"/>
                    </group>
                    <group>
                        <field name="partner_journal_breakdown" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
