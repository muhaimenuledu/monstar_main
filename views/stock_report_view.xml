<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_report_list" model="ir.ui.view">
      <field name="name">stock.report.list</field>
      <field name="model">stock.mles</field>
      <field name="arch" type="xml">
        <list>
            <field name="product_id"/>
            <field name="name" readonly="1"/>
            <field name="default_code" readonly="1"/>
            <field name="categ_id" readonly="1"/>
            <field name="list_price" readonly="1"/>
            <field name="uom_id" readonly="1"/>
            <field name="qty_in" readonly="1"/>
            <field name="qty_out" readonly="1"/>
            <field name="qty_available" readonly="1"/>
            <button name="action_refresh_stock_summary"
                    string="Refresh Products"
                    type="object"
                    class="btn-primary"/>
        </list>
      </field>
    </record>

    <!-- Window Action with Multi-Company Session Scope -->
    <record id="action_stock_report" model="ir.actions.act_window">
      <field name="name">Stock Report</field>
      <field name="res_model">stock.mles</field>
      <field name="view_mode">list,form</field>
      <field name="view_id" ref="view_stock_report_list"/>
      <!-- Dynamically binds default company context to active session company -->
      <field name="context">{'default_company_id': allowed_company_ids[0]}</field>
      <!-- Restricts search query strictly to current allowed companies -->
      <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]</field>
    </record>

</odoo>
